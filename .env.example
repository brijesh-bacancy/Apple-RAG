# LLM provider: extractive (offline, no LLM), ollama, openai or gemini
LLM_PROVIDER=extractive
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K=15
RERANK_TOP_K=5
# none | prose | all  (cross-encoders under-rate table chunks; `compare` measures it)
RERANK_MODE=all
# describe visual pages with a Gemini vision call (cached in data/vision_cache.json)
USE_VISION=1
